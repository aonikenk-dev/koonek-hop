{
  "name": "koonek-hop",
  "version": "0.1.0",
  "private": true,
  "description": "Koonek HOP — AI-powered Healthcare Operations Platform (SaaS). Monorepo for web app, API, and shared packages.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace apps/web",
    "dev:api": "npm run dev --workspace apps/api",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0"
  }
}
