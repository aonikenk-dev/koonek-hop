// Initial multi-tenant schema for Koonek HOP.
// Scope: starter models only (Organization, User, Patient, Doctor, Appointment).
// Remaining domain entities (HealthRecord, Prescription, Visit, etc. — see
// MIGRATION.md Phase 3) get ported incrementally from co-med's Mongoose models.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ExamType {
  PREOCCUPATIONAL
  PERIODIC
  EGRESS
}

enum ExamStatus {
  DRAFT
  COMPLETED
}

enum NationalIdType {
  DNI
  LE
  OTRO
}

enum Role {
  ADMIN
  DOCTOR
  RECEPTIONIST
  PATIENT
}

enum OrganizationStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

model Organization {
  id        String             @id @default(uuid())
  name      String
  slug      String             @unique
  status    OrganizationStatus @default(TRIALING)
  trialEndsAt DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  users                User[]
  patients             Patient[]
  doctors              Doctor[]
  appointments         Appointment[]
  preoccupationalExams PreoccupationalExam[]

  @@map("organizations")
}

model User {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  email          String
  passwordHash   String
  firstName      String
  lastName       String
  role           Role
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, email])
  @@map("users")
}

model Doctor {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  firstName      String
  lastName       String
  specialty      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  appointments Appointment[]

  @@map("doctors")
}

model Patient {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  firstName      String
  lastName       String
  documentId     String?
  email          String?
  phoneNumber    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  appointments          Appointment[]
  preemploymentPatients PreemploymentPatient[]

  @@map("patients")
}

model Appointment {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  doctorId       String
  doctor         Doctor       @relation(fields: [doctorId], references: [id])
  patientId      String
  patient        Patient      @relation(fields: [patientId], references: [id])
  startsAt       DateTime
  endsAt         DateTime
  status         String       @default("scheduled")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("appointments")
}

model PreoccupationalExam {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  examType ExamType
  date     DateTime
  company  String
  place    String
  status   ExamStatus @default(DRAFT)
  position String     @default("")
  tasks    String     @default("")

  // Complex clinical data — stored as JSON, managed entirely by the application layer
  declaration         Json @default("{}")
  habitsDeclaration   Json @default("{}")
  familyHistory       Json @default("{}")
  medicalHistory      Json @default("{}")
  personalAntecedents Json @default("{}")
  clinicalExam        Json @default("{}")
  spirometry          Json @default("{}")
  xrayExam            Json @default("{}")
  result              Json @default("{}")

  // File metadata (name + url); actual binary storage is handled by external service
  attachments           Json @default("[]")
  swornDeclarationFiles Json @default("[]")
  spirometryFiles       Json @default("[]")
  xrayFiles             Json @default("[]")

  patient PreemploymentPatient?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("preoccupational_exams")
}

model PreemploymentPatient {
  id     String              @id @default(uuid())
  examId String              @unique
  exam   PreoccupationalExam @relation(fields: [examId], references: [id], onDelete: Cascade)

  // Populated when "add to patients" is checked on exam creation
  patientId String?
  patient   Patient? @relation(fields: [patientId], references: [id])

  firstName        String
  lastName         String
  nationalIdType   NationalIdType @default(DNI)
  documentId       String
  cuil             String         @default("")
  dateOfBirth      String         @default("")
  birthPlace       String         @default("")
  maritalStatus    String         @default("")
  numberOfChildren Int            @default(0)
  address          String         @default("")
  city             String         @default("")
  postalCode       String         @default("")
  state            String         @default("")
  country          String         @default("Argentina")

  @@map("preemployment_patients")
}
